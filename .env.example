# Aniverse - Environment Variables Template
# Copy this file to .env and fill in your actual values

# API Configuration
# VITE_API_URL=https://api.example.com
# VITE_API_KEY=your_api_key_here

# Firebase Configuration (if using Firebase)
# VITE_FIREBASE_API_KEY=your_firebase_api_key
# VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your_project_id
# VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
# VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# Database Configuration (if using external database)
# VITE_DATABASE_URL=your_database_connection_string

# Third-party Services
# VITE_STRIPE_PUBLIC_KEY=pk_test_xxxxx
# VITE_ANALYTICS_ID=UA-XXXXX-X

# Note: This project currently uses dummy data and doesn't require API keys
# These are examples for future implementation
